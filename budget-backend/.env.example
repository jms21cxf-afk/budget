# MongoDB Atlas 연결 URI (배포·로컬 공통)
# Atlas → Connect → Drivers → connection string 복사
# 예: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/budget?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/budget?retryWrites=true&w=majority

# API 서버 포트 (Render/Railway 등은 PORT를 자동 주입)
PORT=3001

# 배포 시 production (Render 등에서 설정)
# NODE_ENV=production
