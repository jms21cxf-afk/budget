{
  "name": "budget",
  "private": true,
  "workspaces": [
    "budget-backend",
    "budget-frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w budget-backend",
    "dev:frontend": "npm run dev -w budget-frontend",
    "build": "npm run build -w budget-frontend",
    "start": "npm run start -w budget-backend",
    "seed": "npm run seed -w budget-backend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
